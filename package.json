    "test": "node --test test/*.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "sowork": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
