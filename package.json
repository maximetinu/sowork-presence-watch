{
  "name": "presence-watch",
  "version": "0.1.0",
  "description": "Watch your SoWork office from the terminal and get an alert when a teammate's presence changes.",
  "license": "MIT",
  "author": "Metinu",
  "type": "module",
  "bin": {
    "presence-watch": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
